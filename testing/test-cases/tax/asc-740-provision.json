  "known_facts": [
    "Current tax expense is taxable income times applicable tax rate",
    "Deferred tax expense is temporary differences times enacted future tax rates",
    "Valuation allowances use the more-likely-than-not standard under ASC 740-10-30-5",
    "Uncertain tax positions use a two-step process under ASC 740-10-25",
    "Deferred balances are where mistakes compound",
    "Financial statement disclosures are required annually and interim"
  ],
  "ground_truth": [
    "ASC 740",
    "current tax expense",
    "deferred tax",
    "valuation allowance",
    "more-likely-than-not",
    "uncertain tax position",
    "effective tax rate",
    "provision"
  ],
  "format": {
    "required": "markdown",
    "rules": {
      "max_sections": 6,
      "required_disclaimer": ""
    }
  },
  "tests": [
