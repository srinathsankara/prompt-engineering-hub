        "book_income": "$45,000,000",
        "permanent_differences": "$2,000,000"
      },
      "expected": {
        "contains": ["ASC 740", "current tax expense", "deferred tax", "valuation allowance", "more-likely-than-not", "effective tax rate"],
        "format": "markdown"
      },
      "actual": "(populated during test execution)"
    },
    {
