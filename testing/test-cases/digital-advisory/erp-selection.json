        "implementation_budget": "$350,000",
        "implementation_timeline": "12"
      },
      "expected": {
        "contains": ["functional requirements", "weight", "shortlist", "implementation", "TCO"],
        "format": "markdown"
      },
      "actual": "(populated during test execution)"
