  "known_facts": [
    "Every incident is a system failure, not a people failure",
    "A good post-mortem is precise, thorough, actionable, and shared",
    "Root cause is why it happened; contributing factors are why it was allowed to happen",
    "Every finding leads to a concrete, assigned action item",
    "The title format is: Post-Mortem: severity - service - brief description - date"
  ],
  "ground_truth": [
    "blameless",
    "root cause",
    "contributing factors",
    "action item",
    "timeline",
    "impact",
    "lessons learned"
  ],
  "format": {
    "required": "markdown",
    "rules": {
      "max_sections": 6,
      "required_disclaimer": ""
    }
  },
  "tests": [
